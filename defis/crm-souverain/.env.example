# Neon PostgreSQL connection string (avec pooler recommandé pour Vercel)
# À récupérer depuis https://console.neon.tech/ après création du projet
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/eva_pro_crm?sslmode=require"

# Secret du seed. POST /api/seed vide les trois tables avant de repeupler :
# sans ce secret la route repond 503 et ne touche a rien.
# A poser aussi dans les variables d'environnement Vercel.
# Generer une valeur : openssl rand -hex 32
SEED_SECRET="remplace-moi-par-une-valeur-aleatoire"
