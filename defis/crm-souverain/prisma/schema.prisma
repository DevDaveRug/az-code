// CRM Souverain - Prisma schema v0.3
// Aligné sur le stack LIA'M : Neon PostgreSQL, Prisma client, migrations gérées via `prisma db push` sur Vercel.
// v0.2 : multi-tables (SC_Entreprises + SC_Interactions) + relations FK propres.
// v0.3 : schéma isolé `crm` dans le projet Neon partagé "Sales Closer Souverain" (pattern S136z P4, S163z).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // `db push` ne gère que ce schéma : les tables des autres projets de la base partagée restent hors de portée
  schemas  = ["crm"]
}

enum Statut {
  NOUVEAU
  EN_COURS
  GAGNE
  PERDU

  @@schema("crm")
}

enum Source {
  LINKEDIN
  RECOMMANDATION
  SITE
  AUTRE

  @@schema("crm")
}

enum TypeInteraction {
  APPEL
  EMAIL
  LI
  WA
  RDV
  AUTRE

  @@schema("crm")
}

model Entreprise {
  id         Int      @id @default(autoincrement())
  nom        String
  secteur    String?
  taille     String?
  site       String?
  adresse    String?
  notes      String?  @db.Text

  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt      @map("updated_at")

  prospects  Prospect[]

  @@index([nom])
  @@map("sc_entreprises")
  @@schema("crm")
}

model Prospect {
  id                Int      @id @default(autoincrement())
  prenom            String
  nom               String
  entrepriseId      Int?     @map("entreprise_id")
  email             String
  telephone         String?
  statut            Statut   @default(NOUVEAU)
  source            Source   @default(AUTRE)
  dateEntree        DateTime @default(now())        @map("date_entree")
  dernierContact    DateTime @default(now())        @map("dernier_contact")
  notes             String?  @db.Text
  montantPotentiel  Decimal? @db.Decimal(10, 2)     @map("montant_potentiel")

  createdAt         DateTime @default(now())        @map("created_at")
  updatedAt         DateTime @updatedAt             @map("updated_at")

  entreprise        Entreprise?    @relation(fields: [entrepriseId], references: [id], onDelete: SetNull)
  interactions      Interaction[]

  @@index([statut, dernierContact])
  @@index([dateEntree])
  @@index([entrepriseId])
  @@map("sc_prospects")
  @@schema("crm")
}

model Interaction {
  id          Int              @id @default(autoincrement())
  prospectId  Int              @map("prospect_id")
  type        TypeInteraction  @default(AUTRE)
  date        DateTime
  resume      String           @db.Text
  resultat    String?          @db.Text
  nextStep    String?          @db.Text            @map("next_step")

  createdAt   DateTime         @default(now())     @map("created_at")

  prospect    Prospect         @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId, date])
  @@map("sc_interactions")
  @@schema("crm")
}
