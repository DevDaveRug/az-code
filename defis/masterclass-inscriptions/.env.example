# Neon PostgreSQL - connection string, format postgres://user:pass@host/db?sslmode=require
DATABASE_URL=""

# Resend API key (email transactionnel) - dashboard.resend.com/api-keys
# Créer un domaine vérifié (ou utiliser resend.dev en dev)
RESEND_API_KEY=""

# Expéditeur des emails de confirmation (doit être vérifié dans Resend)
# En dev : onboarding@resend.dev
# En prod : ex. hello@salescloser.fr
EMAIL_FROM="onboarding@resend.dev"

# Mode d'envoi email en dev :
#   "resend" -> envoi réel via Resend
#   "console" -> log dans la console (aucun envoi, utile en local sans clé API)
EMAIL_MODE="console"
