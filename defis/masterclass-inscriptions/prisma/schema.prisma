// Masterclass Inscriptions - Prisma schema v0.1
// Défi Alegria n°3 semaine 38. Stack aligné LIA'M : Neon PostgreSQL, Prisma client, migrations via `prisma db push` sur Vercel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatutEmail {
  EN_ATTENTE
  ENVOYE
  ERREUR
}

model Inscrit {
  id                Int         @id @default(autoincrement())
  prenom            String
  email             String
  dateMasterclass   DateTime    @db.Date               @map("date_masterclass")
  statutEmail       StatutEmail @default(EN_ATTENTE)   @map("statut_email")
  emailError        String?     @db.Text               @map("email_error")
  notes             String?     @db.Text
  dateInscription   DateTime    @default(now())        @map("date_inscription")

  @@index([dateMasterclass])
  @@index([statutEmail])
  @@map("az_inscrits")
}
