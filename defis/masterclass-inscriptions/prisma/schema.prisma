// Masterclass Inscriptions - Prisma schema v0.1
// Défi Alegria n°3 semaine 38. Stack aligné LIA'M : Neon PostgreSQL, Prisma client, migrations via `prisma db push` sur Vercel.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  // Requis pour Vercel (fonctions serverless) : le moteur "native" généré au build
  // ne correspond pas toujours à l'environnement d'exécution réel des fonctions.
  binaryTargets   = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Schéma isolé dans le projet Neon partagé "Sales Closer Souverain" (S136z) --
  // même base que défi 2 (cr-rdv-souverain), mais table dans son propre schéma
  // Postgres pour ne jamais entrer en collision avec les tables d'un autre défi.
  schemas  = ["masterclass"]
}

enum StatutEmail {
  EN_ATTENTE
  ENVOYE
  ERREUR

  @@schema("masterclass")
}

model Inscrit {
  id                Int         @id @default(autoincrement())
  prenom            String
  email             String
  dateMasterclass   DateTime    @db.Date               @map("date_masterclass")
  statutEmail       StatutEmail @default(EN_ATTENTE)   @map("statut_email")
  emailError        String?     @db.Text               @map("email_error")
  notes             String?     @db.Text
  dateInscription   DateTime    @default(now())        @map("date_inscription")

  @@index([dateMasterclass])
  @@index([statutEmail])
  @@map("az_inscrits")
  @@schema("masterclass")
}
