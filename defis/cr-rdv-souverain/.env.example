# Base Neon Postgres (URL avec pooler recommandée)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/cr_rdv?sslmode=require"

# Webhook n8n qui appelle OpenRouter et retourne le CR formaté
# Exemple : https://n8n.davidruggieri.com/webhook/cr-rdv-format
N8N_WEBHOOK_URL=""

# Secret partagé n8n <-> Next.js pour authentifier les appels webhook
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
N8N_WEBHOOK_SECRET=""

# Modèle LLM par défaut (surchargeable par n8n)
# Options recommandées : anthropic/claude-sonnet-5, google/gemini-2.5-flash, mistralai/mistral-large-latest
LLM_MODEL_DEFAULT="anthropic/claude-sonnet-5"
