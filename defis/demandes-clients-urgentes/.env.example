# Neon PostgreSQL - connection string, format postgres://user:pass@host/db?sslmode=require&schema=demandes
# Sur Neon "Sales Closer Souverain" (orange-cake-12929525), rôle neondb_owner ou dédié
DATABASE_URL=""

# Resend API key (email transactionnel) - dashboard.resend.com/api-keys
# Créer un domaine vérifié (ou utiliser resend.dev en dev)
RESEND_API_KEY=""

# Expéditeur des emails de confirmation (doit être vérifié dans Resend)
# En dev : onboarding@resend.dev
# En prod : ex. hello@salescloser.fr
EMAIL_FROM="onboarding@resend.dev"

# Mode d'envoi email :
#   "resend" -> envoi réel via Resend
#   "console" -> log dans la console (aucun envoi, utile en local sans clé API)
EMAIL_MODE="console"

# Telegram Bot pour les notifs urgence Haute/Critique
# Créer via @BotFather, récupérer le token et ton chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Mode Telegram :
#   "telegram" -> envoi réel
#   "console" -> log dans la console
TELEGRAM_MODE="console"
